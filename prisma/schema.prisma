  L
  P
}

enum Agama {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDDHA
  KONGHUCU
}

enum StatusKawin {
  BELUM_KAWIN
  KAWIN
  CERAI_HIDUP
  CERAI_MATI
}

enum LayananDifabel {
  YA
  TIDAK
}

enum GolDarah {
  A
  B
  AB
  O
}

enum Rhesus {
  POSITIF
  NEGATIF
}

enum Clinic {
  LANSIA
  INFEKSIUS_A
  INFEKSIUS_B
  INFEKSIUS_C
  NON_INFEKSIUS_A
  NON_INFEKSIUS_B
  NON_INFEKSIUS_C
  UGD
  GIGI
  KIA
  UMUM
}

enum AttendanceStatus {
  HADIR
  TIDAK_HADIR
